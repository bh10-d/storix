{
  "name": "storix",
  "version": "0.1.0",
  "description": "A pluggable file storage abstraction library for TypeScript and Node.js",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit",
    "dev": "tsx watch src/index.ts"
  },
  "keywords": [
    "storage",
    "file-storage",
    "typescript",
    "nodejs",
    "minio",
    "s3",
    "local-storage",
    "object-storage"
  ],
  "author": "Hieu Bui Duc",
  "license": "MIT",
  "dependencies": {
    "minio": "^8.0.7"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}